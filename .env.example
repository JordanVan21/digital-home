# Copy to .env at the repo root and fill in. Never commit .env.

# --- Supabase (project settings > API) ---
SUPABASE_URL=https://synyznfvklhsosnaivno.supabase.co
SUPABASE_ANON_KEY=
# Secret: full database access. Worker and seed script only.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI model for the render agent: fill in ONE provider ---
AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Blender (worker builds/edits models when the library has no good match) ---
# 1 = may build new models, 0 = library matches only.
ALLOW_GENERATION=1
BLENDER_MCP_PORT=9876
# Parallel headless Blender copies.
BLENDER_INSTANCES=3
# Max seconds per scan spent improving models (the room opens immediately anyway).
SCAN_TIME_LIMIT_S=900
